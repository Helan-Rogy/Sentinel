# ==============================================================================
# Aegis Sentinel - Deployment Environment Configuration
# ==============================================================================

# Bearer Token for Operator Authentication and Agent Event Ingestion
# Recommended: Generate a 32+ character random hex string: openssl rand -hex 16
SENTINEL_TOKEN=dev-token

# Host Port (default: 8000). Set to 80 or 443 if binding directly to standard HTTP/S
PORT=8000

# Security containment policy:
# Set to 1 to allow operator approval of process suspensions
SENTINEL_ALLOW_SUSPEND=1

# Set to 1 to enable autonomous automatic host containment without operator prompt
SENTINEL_ALLOW_AUTO_CONTAIN=0

# Database path (inside container: /app/data/sentinel.db)
SENTINEL_DB=/app/data/sentinel.db
